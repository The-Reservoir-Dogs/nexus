# Copy to .env and fill from the `nexus` Databricks secret scope.
# Get password: databricks secrets get-secret nexus pg_password

PGHOST=ep-round-bar-d8cmwzqy.database.us-east-2.cloud.databricks.com
PGPORT=5432
PGDATABASE=databricks_postgres
PGUSER=nexus_app
PGPASSWORD=
PGSSLMODE=require

# LLM for the agent. Provider is chosen from LLM_ENDPOINT:
#   gemini-*                    -> Gemini OpenAI-compatible API (needs GEMINI_API_KEY)
#   databricks-*                -> Databricks serving endpoint (needs DATABRICKS_HOST/TOKEN)
# Free Edition gates premium Databricks models (claude/gpt-5/gemini) to rate-limit 0.
# Confirmed-free Databricks writers: databricks-llama-4-maverick, meta-llama-3-3-70b-instruct.
DATABRICKS_HOST=https://dbc-60b5b94b-8e3e.cloud.databricks.com
DATABRICKS_TOKEN=
LLM_ENDPOINT=gemini-2.5-flash

# Gemini (writer LLM in testing + TTS narration). Get from Google AI Studio.
GEMINI_API_KEY=
